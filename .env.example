# Copy this file to .env and fill in the values from your Firebase project
# (Firebase console → Project settings → General → Your apps → SDK setup and configuration).
# These are also the names of the GitHub Actions secrets used by
# .github/workflows/deploy.yml and deploy-preview.yml.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
