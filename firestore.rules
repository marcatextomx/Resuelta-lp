rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contact-form leads: the public site can only create one (never read,
    // edit, list, or delete). Review them from the Firebase console, which
    // uses your Google account's project access, not these client rules.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'telefono', 'empresa', 'empleados', 'createdAt'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() < 200
        && request.resource.data.telefono is string && request.resource.data.telefono.size() < 50
        && request.resource.data.empresa is string && request.resource.data.empresa.size() < 200;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
